[ext_resource type="Script" path="res://core/data/BossAttackDef.gd" id="1_mrgix"]

[resource]
script = ExtResource("1_mrgix")
attack_kind = "pattern"
doc = "Black Sunday's bullet heaven. BLACK BLIZZARD across the screen, the sand darkens round him and he spins up into a black storm while a fence of crooked grave crosses and barbed wire rises out of the sand 18.9 m round him and you (you are kept inside it; what flies at it stops there). Then for 16 s tumbling grit pours out in long curved arms: four fast arms sweep one way and four slow ones the other, so the gaps between them open and close; halfway the fast arms turn back; every 3.5 s a ragged wall of grit crosses towards you with a gap in it. He takes 80% less damage until it ends, then the fence falls apart and he stands dazed for 2.5 s taking 50% more. Not before 15 s into the fight; the first when he falls under 60% HP (or 45 s in at the latest); then 45 s after the last one is completely over."
