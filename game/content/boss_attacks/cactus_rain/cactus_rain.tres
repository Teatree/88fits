"count": 0.0,
"gap": 1.0,
"jitter": 0.25,
"order": "out",
"radius_max": 16.0,
"radius_min": 3.6,
"shape": "rings",
"spacing": 3.9,
"turn": true
}
landing = {
"mode": "volley",
"radius": 1.4
}
