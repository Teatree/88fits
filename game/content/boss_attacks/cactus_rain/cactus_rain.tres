[ext_resource type="Script" path="res://core/data/BossAttackDef.gd" id="1_if6ng"]

[resource]
script = ExtResource("1_if6ng")
doc = "Every landing spot round the Gila Grande lights up red at once; it crouches, rears up and spews a burst of big red cactus spikes out of its mouth, and they all come down together a moment later, on rings of wide circles with a narrow gap between every two. Find a gap before the spew."
projectile = {
"arc": 7.0,
"flight": 1.1,
"glow": 1.2,
"look": "spike",
"size": 2.72,
"tint": "#D0242F",
"trail": true
}
pattern = {
