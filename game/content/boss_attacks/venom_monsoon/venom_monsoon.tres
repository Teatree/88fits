[ext_resource type="Script" path="res://core/data/BossAttackDef.gd" id="1_pppjt"]

[resource]
script = ExtResource("1_pppjt")
attack_kind = "pattern"
doc = "The Gila Grande's bullet heaven. VENOM MONSOON across the screen, the sand darkens round her, she rears up and her throat swells and glows purple while a hedge of spiny cactus columns with venom blooms grows out of the sand 14 m round her and you (you are kept inside it; what flies at it stops there); then for 14 s she sprays big, slow, wobbling venom blobs in a fan that sweeps left and right like a garden sprinkler, its middle always swinging across wherever you stand, and every second sweep adds a second, offset fan. The blobs leave little purple puddles where they fade (only a look). Her scales glow like armour: 80% less damage until it ends, then the hedge falls apart and she collapses panting for 2.5 s taking 50% more. Not before 15 s into the fight; the first when she falls under 60% HP (or 45 s in at the latest); then 45 s after the last one is completely over (her panting seconds too)."
