[gd_resource type="Resource" script_class="BossAttackDef" format=3]

[ext_resource type="Script" path="res://core/data/BossAttackDef.gd" id="1_cdvau"]

[resource]
script = ExtResource("1_cdvau")
attack_kind = "pattern"
doc = "The Tumbleweed King's bullet heaven. ROYAL DUST DEVIL across the screen, the sand darkens round him and he spins up into a sand tornado while a fence of staked tumbleweeds rises out of the sand 14 m round him and you (you are kept inside it; what flies at it stops there); then for 16 s three spiral arms of small burning tumbleweeds turn slowly outwards (the arms turn back the other way halfway, so the safe lanes change) while a ring with an opening in a new place rolls out every 1.7 s. He takes 80% less damage until it ends, then the fence falls apart and he lies dizzy for 2.5 s taking 50% more. Not before 15 s into the fight; the first when he falls under 60% HP (or 30 s in at the latest); then 45 s after the last one is completely over (its dizzy seconds too)."
