[ext_resource type="Script" path="res://core/data/BossAttackDef.gd" id="1_5c641"]

[resource]
script = ExtResource("1_5c641")
attack_kind = "pattern"
doc = "The Brander's bullet heaven. HELLBRAND MANDALA across the screen, the sand darkens round him and he drives his branding iron into the ground: a glowing brand sigil 12 m across burns into the sand under him and an iron fence of white-hot spears and branding irons rises out of the sand 14 m round him and you (you are kept inside it; what flies at it stops there). Then for 18 s slow branded fireballs bloom out of him in a five-petal rose (the petals race out, the dips between them crawl, the petals open and close), and every 3 s the mandala turns half a petal, so the safe lines move. In its last second every fireball still flying is pulled back towards him: never stand between a fireball and the Brander. He stands in a pillar of fire, taking 80% less damage until it ends; then the fence falls apart, the pillar gutters out, his iron smokes and he takes 50% more for 2.5 s. Not before 15 s into the fight; the first when he falls under 60% HP (or 45 s in at the latest); then 45 s after the last one is completely over (his smoking seconds too)."
